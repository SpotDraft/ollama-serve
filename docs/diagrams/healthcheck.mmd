flowchart LR
    W["healthcheck.sh --watch<br/>every 5s"] --> P["curl --unix-socket sock /api/version"]
    P --> D{"socket healthy?"}
    D -->|yes| C["add server unix:/sockets/ollama-N.sock"]
    D -->|no| X["# ollama-N DOWN"]
    C --> CF["write upstream.conf.tmp"]
    X --> CF
    CF --> CH{"changed vs current?"}
    CH -->|yes| R["mv + nginx -s reload"]
    CH -->|no| L["discard tmp, keep running"]
    R --> W
    L --> W
