# ollama-serve environment.
#
# Copy to `.env` (setup.sh does this for you) and uncomment what you need.
# `docker compose` reads `.env` from this directory automatically.
#
# Every value below is optional — the stack has working defaults for all of
# them. Nothing here affects the base stack unless the telemetry overlay is on.

# ===========================================================================
# eBPF telemetry (OpenTelemetry eBPF Instrumentation) — off by default
# ===========================================================================

# THE ON/OFF SWITCH. Uncomment to make docker-compose.otel.yml part of the
# stack; `docker compose up -d` then also starts `obi` and `collector`.
# Re-comment it (after one `docker compose down`) to go back to the base
# stack. Every other variable in this file is inert while this is commented.
#COMPOSE_FILE=docker-compose.yml:docker-compose.otel.yml

# --- Collector -------------------------------------------------------------

# Which pipeline the collector runs.
#   /etc/collector/local.yaml    keep everything on this host (default)
#   /etc/collector/forward.yaml  relay to an external OTLP/HTTP backend
#COLLECTOR_CONFIG_FILE=/etc/collector/local.yaml

# `basic` logs span/metric counts; `detailed` dumps full payloads into
# `docker compose logs collector`. Useful while verifying, noisy long-term.
#COLLECTOR_DEBUG_VERBOSITY=basic
#COLLECTOR_LOG_LEVEL=info

# --- Forwarding (only used by forward.yaml) --------------------------------

#OTLP_FORWARD_ENDPOINT=https://otlp.example.internal:4318
# For authenticated backends, also uncomment the `headers` block in
# otel/collector/forward.yaml.
#OTLP_FORWARD_AUTHORIZATION=Bearer <token>
#OTLP_FORWARD_INSECURE_SKIP_VERIFY=false

# --- OBI -------------------------------------------------------------------

# Where OBI sends OTLP. Point this at your own endpoint to bypass the
# bundled collector entirely (it then just sits idle).
#OBI_OTLP_ENDPOINT=http://collector:4318
#OBI_OTLP_PROTOCOL=http/protobuf

#OBI_LOG_LEVEL=INFO

# Metric families to export. `application_service_graph` is what produces the
# nginx -> ollama topology; drop it if you only want RED metrics.
#OBI_METRICS_FEATURES=application,application_span,application_service_graph

# Protocol-level instrumentations. `genai` captures LLM calls, `gpu` captures
# GPU activity. Fewer entries means fewer eBPF probes attached.
#OBI_METRICS_INSTRUMENTATIONS=http,grpc,genai,gpu
#OBI_TRACES_INSTRUMENTATIONS=http,grpc,genai

# Set to `text` to print every span into `docker compose logs obi` — the
# fastest way to confirm OBI is seeing traffic. Leave `disabled` in normal use.
#OBI_TRACE_PRINTER=disabled

# Set to `true` to make OBI exit on a missing kernel capability instead of
# running with reduced functionality. Off by default so an unusual kernel
# degrades rather than crash-loops.
#OBI_ENFORCE_SYS_CAPS=false
